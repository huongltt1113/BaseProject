<?xml version="1.0" encoding="utf-8"?>

                                                       
                                                   

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:orientation="vertical" android:tag="layout/fragment_grant_permission_0" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools">

        <androidx.appcompat.widget.Toolbar
            android:layout_width="match_parent"
            android:layout_height="@dimen/common_56dp"
            android:background="@drawable/bg_toolbar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="@dimen/common_20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:paddingVertical="@dimen/common_12dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_arrow_left"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/heading"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/common_12dp"
                    android:layout_marginTop="@dimen/common_2dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/poppinsmedium"
                    android:gravity="center_vertical"
                    android:text="@string/grant_permission"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_16sp" />

            </LinearLayout>

        </androidx.appcompat.widget.Toolbar>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="@dimen/common_200dp"
                    android:layout_height="@dimen/common_200dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/common_20dp"
                    android:src="@drawable/img_grant_permission" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="3"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/common_24dp"
                        android:fontFamily="@font/poppinsregular"
                        android:gravity="center_horizontal"
                        android:paddingHorizontal="@dimen/common_20dp"
                        android:text="@string/label_grant_permission"
                        android:textColor="@color/color_6F7384"
                        android:textSize="@dimen/text_size_13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/common_20dp"
                        android:layout_marginTop="@dimen/common_16dp"
                        android:background="@drawable/bg_item_grant_permission"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/common_12dp"
                        android:paddingVertical="@dimen/common_12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/poppinsmedium"
                                android:text="@string/notification_permission"
                                android:textColor="@color/black"
                                android:textSize="@dimen/text_size_13sp"
                                android:textStyle="bold" />

                            <FrameLayout
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_gravity="center">

                                <com.google.android.material.materialswitch.MaterialSwitch
                                    android:id="@+id/swNotification"
                                    style="@style/Widget.App.Switch"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:scaleX="0.7"
                                    android:scaleY="0.7" />

                                <TextView
                                    android:id="@+id/tvNotificationAllowed"
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:fontFamily="@font/poppinsregular"
                                    android:gravity="center_vertical"
                                    android:visibility="gone"
                                    android:text="@string/allowed"
                                    android:textColor="@color/dark_green"
                                    android:textSize="@dimen/text_size_13sp"
                                    android:textStyle="bold" />
                            </FrameLayout>
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppinsregular"
                            android:text="@string/notification_permission_label"
                            android:textColor="@color/black"
                            android:textSize="@dimen/text_size_13sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/common_20dp"
                        android:layout_marginTop="@dimen/common_16dp"
                        android:layout_marginBottom="@dimen/common_16dp"
                        android:background="@drawable/bg_item_grant_permission"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/common_12dp"
                        android:paddingVertical="@dimen/common_12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/poppinsmedium"
                                android:text="@string/record_permission"
                                android:textColor="@color/black"
                                android:textSize="@dimen/text_size_13sp"
                                android:textStyle="bold" />

                            <FrameLayout
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_gravity="center">

                                <com.google.android.material.materialswitch.MaterialSwitch
                                    android:id="@+id/swRecord"
                                    style="@style/Widget.App.Switch"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:scaleX="0.7"
                                    android:scaleY="0.7" />

                                <TextView
                                    android:id="@+id/tvRecordAllowed"
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:fontFamily="@font/poppinsregular"
                                    android:gravity="center_vertical"
                                    android:visibility="gone"
                                    android:text="@string/allowed"
                                    android:textColor="@color/dark_green"
                                    android:textSize="@dimen/text_size_13sp"
                                    android:textStyle="bold" />
                            </FrameLayout>
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppinsregular"
                            android:text="@string/record_permission_label"
                            android:textColor="@color/black"
                            android:textSize="@dimen/text_size_13sp"/>
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

         