<?xml version="1.0" encoding="utf-8"?>

                                                        

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white_background" android:tag="layout/fragment_choose_sound_0" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbarLayout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/common_56dp"
                android:background="@drawable/bg_toolbar">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="@dimen/common_20dp"
                    android:layout_marginVertical="@dimen/common_12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/back"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:paddingVertical="@dimen/common_12dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_arrow_left"
                        app:tint="@color/white" />

                    <TextView
                        android:id="@+id/heading"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/common_12dp"
                        android:layout_marginTop="@dimen/common_2dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/poppinsmedium"
                        android:gravity="center_vertical"
                        android:text="@string/choose_sound_title"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_size_16sp" />

                </LinearLayout>

            </androidx.appcompat.widget.Toolbar>

            <androidx.cardview.widget.CardView
                android:id="@+id/tabsLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/toolbarLayout"
                android:layout_marginHorizontal="@dimen/common_20dp"
                android:layout_marginTop="@dimen/common_5dp"
                app:cardBackgroundColor="@color/grey_50"
                app:cardCornerRadius="@dimen/common_16dp">

                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tabLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/transparent"
                    app:tabGravity="fill"
                    app:tabIndicatorGravity="center"
                    app:tabIndicatorHeight="0dp"
                    app:tabMaxWidth="0dp"
                    app:tabMode="fixed"
                    app:tabSelectedTextColor="@color/white"
                    app:tabTextAppearance="@style/MyTabTextAppearance"
                    app:tabTextColor="@color/tab_text_color_normal" />
            </androidx.cardview.widget.CardView>

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/view_pager"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_below="@+id/tabsLayout"
                android:layout_alignParentBottom="true"
                android:layout_marginTop="@dimen/common_16dp"
                app:layout_behavior="@string/appbar_scrolling_view_behavior" />

        </RelativeLayout>
    </RelativeLayout>

         