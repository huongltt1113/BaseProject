<?xml version="1.0" encoding="utf-8"?>
        

    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white" android:tag="layout/fragment_passcord_0">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <androidx.appcompat.widget.Toolbar
                android:layout_width="match_parent"
                android:layout_height="@dimen/common_56dp"
                android:background="@drawable/bg_toolbar">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="@dimen/common_20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/btnBack"
                        app:tint="@color/white"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_arrow_left"
                        android:paddingVertical="@dimen/common_12dp"/>

                    <TextView
                        android:id="@+id/heading"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginTop="@dimen/common_2dp"
                        android:layout_marginStart="@dimen/common_12dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:text="@string/create_passcode"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_size_16sp"
                        android:fontFamily="@font/poppinsmedium"/>

                    <ImageView
                        android:id="@+id/btnHelp"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_help_circle"
                        android:backgroundTint="@color/white"
                        android:paddingVertical="@dimen/common_12dp"/>

                </LinearLayout>

            </androidx.appcompat.widget.Toolbar>

            <FrameLayout
                android:id="@+id/recordpassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/common_20dp"
                android:layout_marginTop="@dimen/common_16dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:src="@drawable/bg_record_passcode"
                    android:layout_marginTop="@dimen/common_40dp"
                    android:scaleType="fitEnd"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <ImageView
                        android:layout_width="@dimen/common_120dp"
                        android:layout_height="@dimen/common_120dp"
                        android:src="@drawable/ic_voice_big_size"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:text="@string/record_passcode"
                        android:textSize="@dimen/text_size_13sp"
                        android:fontFamily="@font/poppinsregular"
                        android:textColor="@color/white"
                        android:gravity="center"/>

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="2"
                        android:src="@drawable/ic_arrow_circle"
                        android:padding="@dimen/common_10dp"/>

                </LinearLayout>

            </FrameLayout>

            <FrameLayout
                android:id="@+id/recordtext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/common_20dp"
                android:layout_marginTop="@dimen/common_20dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/common_30dp"
                    android:src="@drawable/bg_text_to_voice_passcord"
                    android:scaleType="fitEnd"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <ImageView
                        android:layout_width="@dimen/common_100dp"
                        android:layout_height="@dimen/common_100dp"
                        android:src="@drawable/ic_document"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:text="@string/text_to_voice"
                        android:textSize="@dimen/text_size_13sp"
                        android:fontFamily="@font/poppinsregular"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:layout_marginTop="@dimen/common_10dp"/>

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="2"
                        android:src="@drawable/ic_arrow_circle"
                        android:padding="@dimen/common_10dp"/>

                </LinearLayout>

            </FrameLayout>

        </LinearLayout>

        <RelativeLayout
            android:id="@+id/btm1"
            android:layout_width="match_parent"
            android:layout_height="@dimen/common_70dp"
            android:gravity="center"
            android:layout_alignParentBottom="true"
            android:visibility="gone" android:tag="binding_1">

            <include
                android:id="@+id/reguler_banner_ad"
                layout="@layout/ads_layout_banner"
                android:visibility="visible" />

        </RelativeLayout>

    </RelativeLayout>
         