<?xml version="1.0" encoding="utf-8"?>
                                                                   

    <LinearLayout
        android:id="@+id/soundLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/common_8dp"
        android:layout_marginHorizontal="@dimen/common_16dp"
        android:background="@drawable/bg_curved_24dp_white"
        android:orientation="horizontal"
        android:paddingVertical="@dimen/common_16dp" android:tag="layout/item_choose_sound_0" xmlns:android="http://schemas.android.com/apk/res/android">

        <ImageView
            android:id="@+id/ivSound"
            android:layout_width="@dimen/common_24dp"
            android:layout_height="@dimen/common_24dp"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/common_16dp"
            android:src="@drawable/ic_melody" />

        <TextView
            android:id="@+id/tvSound"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/common_12dp"
            android:fontFamily="@font/poppinsmedium"
            android:textColor="@color/maintextcolor"
            android:textSize="@dimen/text_size_13sp" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_arrow_right"
            android:layout_marginEnd="@dimen/common_16dp"
            android:layout_gravity="center"/>
    </LinearLayout>
         