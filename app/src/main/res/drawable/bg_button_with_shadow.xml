<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow Layer -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:startColor="#6169C0FF"
                android:endColor="#6181FFE8"
                android:centerColor="#6181FFE8"
                android:centerY="1.0"/>
            <corners android:radius="24dp" /> <!-- Màu bóng xanh nhạt với 38% opacity -->
            <corners android:radius="24dp"/>
            <padding
                android:left="9dp"
                android:top="9dp"
                android:right="9dp"
                android:bottom="9dp" />
        </shape>
    </item>

    <!-- Button Background Layer -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:startColor="#69C0FF"
            android:endColor="#81FFE8"
            android:centerColor="#81FFE8"
            android:centerY="1.0"/>
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
