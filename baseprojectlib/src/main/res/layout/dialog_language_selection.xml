<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_rectangle_16"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/common_20dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="500dp"
        android:scrollbars="none">

        <RadioGroup
            android:id="@+id/radioGroupLanguages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/radioButtonEnglishv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/radiolangbg"
                android:button="@null"
                android:drawableEnd="@drawable/radio_button_custom_selector"
                android:fontFamily="@font/poppinsregular"
                android:padding="@dimen/common_12dp"
                android:text="@string/english"
                android:textColor="@drawable/lang_option_text_style"
                android:textSize="@dimen/text_size_13sp" />

            <RadioButton
                android:id="@+id/radioButtonSpanishv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/common_10dp"
                android:background="@drawable/radiolangbg"
                android:button="@null"
                android:drawableRight="@drawable/radio_button_custom_selector"
                android:fontFamily="@font/poppinsregular"
                android:padding="@dimen/common_12dp"
                android:text="@string/spanish"
                android:textColor="@drawable/lang_option_text_style"
                android:textSize="@dimen/text_size_13sp" />

            <RadioButton
                android:id="@+id/radioButtonHindiv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/common_10dp"
                android:background="@drawable/radiolangbg"
                android:button="@null"
                android:drawableRight="@drawable/radio_button_custom_selector"
                android:fontFamily="@font/poppinsregular"
                android:padding="@dimen/common_12dp"
                android:text="@string/hindi"
                android:textColor="@drawable/lang_option_text_style"
                android:textSize="@dimen/text_size_13sp" />

            <RadioButton
                android:id="@+id/radioButtonJapanesev"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/common_10dp"
                android:background="@drawable/radiolangbg"
                android:button="@null"
                android:drawableRight="@drawable/radio_button_custom_selector"
                android:fontFamily="@font/poppinsregular"
                android:padding="@dimen/common_12dp"
                android:text="@string/japanese"
                android:textColor="@drawable/lang_option_text_style"
                android:textSize="@dimen/text_size_13sp" />

            <RadioButton
                android:id="@+id/radioButtonKoreanv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/common_10dp"
                android:background="@drawable/radiolangbg"
                android:button="@null"
                android:drawableRight="@drawable/radio_button_custom_selector"
                android:fontFamily="@font/poppinsregular"
                android:padding="@dimen/common_12dp"
                android:text="@string/korean"
                android:textColor="@drawable/lang_option_text_style"
                android:textSize="@dimen/text_size_13sp" />

            <RadioButton
                android:id="@+id/radioButtonGermanv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/common_10dp"
                android:background="@drawable/radiolangbg"
                android:button="@null"
                android:drawableRight="@drawable/radio_button_custom_selector"
                android:fontFamily="@font/poppinsregular"
                android:padding="@dimen/common_12dp"
                android:text="@string/german"
                android:textColor="@drawable/lang_option_text_style"
                android:textSize="@dimen/text_size_13sp" />

            <RadioButton
                android:id="@+id/radioButtonPortuguesev"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/common_10dp"
                android:background="@drawable/radiolangbg"
                android:button="@null"
                android:drawableRight="@drawable/radio_button_custom_selector"
                android:fontFamily="@font/poppinsregular"
                android:padding="@dimen/common_12dp"
                android:text="@string/portuguese"
                android:textColor="@drawable/lang_option_text_style"
                android:textSize="@dimen/text_size_13sp" />

            <RadioButton
                android:id="@+id/radioButtonVietnamesev"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/common_10dp"
                android:background="@drawable/radiolangbg"
                android:button="@null"
                android:drawableRight="@drawable/radio_button_custom_selector"
                android:fontFamily="@font/poppinsregular"
                android:padding="@dimen/common_12dp"
                android:text="@string/vietnamese"
                android:textColor="@drawable/lang_option_text_style"
                android:textSize="@dimen/text_size_13sp" />

            <RadioButton
                android:id="@+id/radioButtonTurkishv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/common_10dp"
                android:background="@drawable/radiolangbg"
                android:button="@null"
                android:drawableRight="@drawable/radio_button_custom_selector"
                android:fontFamily="@font/poppinsregular"
                android:padding="@dimen/common_12dp"
                android:text="@string/turkish"
                android:textColor="@drawable/lang_option_text_style"
                android:textSize="@dimen/text_size_13sp" />

            <RadioButton
                android:id="@+id/radioButtonRussianv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/common_10dp"
                android:background="@drawable/radiolangbg"
                android:button="@null"
                android:drawableRight="@drawable/radio_button_custom_selector"
                android:fontFamily="@font/poppinsregular"
                android:padding="@dimen/common_12dp"
                android:text="@string/russian"
                android:textColor="@drawable/lang_option_text_style"
                android:textSize="@dimen/text_size_13sp" />

            <RadioButton
                android:id="@+id/radioButtonUkrainianv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/common_10dp"
                android:background="@drawable/radiolangbg"
                android:button="@null"
                android:drawableRight="@drawable/radio_button_custom_selector"
                android:fontFamily="@font/poppinsregular"
                android:padding="@dimen/common_12dp"
                android:text="@string/ukrainian"
                android:textColor="@drawable/lang_option_text_style"
                android:textSize="@dimen/text_size_13sp" />

            <RadioButton
                android:id="@+id/radioButtonArabicv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/common_10dp"
                android:background="@drawable/radiolangbg"
                android:button="@null"
                android:drawableRight="@drawable/radio_button_custom_selector"
                android:fontFamily="@font/poppinsregular"
                android:padding="@dimen/common_12dp"
                android:text="@string/arabic"
                android:textColor="@drawable/lang_option_text_style"
                android:textSize="@dimen/text_size_13sp" />

            <RadioButton
                android:id="@+id/radioButtonChinesev"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/common_10dp"
                android:background="@drawable/radiolangbg"
                android:button="@null"
                android:drawableRight="@drawable/radio_button_custom_selector"
                android:fontFamily="@font/poppinsregular"
                android:padding="@dimen/common_12dp"
                android:text="@string/chinese"
                android:textColor="@drawable/lang_option_text_style"
                android:textSize="@dimen/text_size_13sp" />
        </RadioGroup>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/buttonOk"
            style="@style/ButtonConfirmStyle"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/common_24dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/select" />

        <TextView
            android:id="@+id/buttonCancel"
            style="@style/ButtonCancelStyle"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/common_12dp"
            android:layout_weight="1"
            android:text="@string/cancel" />

    </LinearLayout>

</LinearLayout>
