<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context="com.example.baseprojectlib.ui.component.sound.ChooseSoundEffectFragment">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSoundEffect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            android:layout_marginHorizontal="@dimen/common_12dp"
            android:paddingBottom="@dimen/common_12dp"
            android:clipToPadding="false"
            app:spanCount="3"/>

    </FrameLayout>
</layout>