<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bottomsheet_corner_shape"
        android:padding="@dimen/common_20dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="@dimen/common_32dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnClose"
            app:layout_constraintTop_toTopOf="parent"
            android:text="@string/custom"
            android:textColor="@color/color_424141"
            android:textSize="@dimen/text_size_16sp"
            android:textStyle="bold"
            android:fontFamily="@font/poppinsmedium"
            android:gravity="center_vertical"
            android:paddingTop="2dp"
            android:textAllCaps="true"/>

        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="@dimen/common_32dp"
            android:layout_height="@dimen/common_32dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:src="@drawable/ic_close_app"
            android:paddingLeft="@dimen/common_6dp"
            app:tint="@color/black" />

        <FrameLayout
            android:id="@+id/hourLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/common_8dp"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/minuteLayout"
            app:layout_constraintTop_toBottomOf="@id/btnClose">

            <com.shawnlin.numberpicker.NumberPicker
                android:id="@+id/hourPicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:np_dividerColor="@color/mint"
                app:np_selectedTextColor="@color/number_picker_text_color"
                app:np_textColor="@color/grey_150"
                app:np_dividerThickness="@dimen/common_1dp"
                app:np_textSize="@dimen/text_size_14sp"
                app:np_wheelItemCount="5"
                app:np_itemSpacing="@dimen/common_10dp"
                app:np_selectedTextSize="@dimen/text_size_20sp"
                app:np_max="59"
                app:np_min="0"
                android:visibility="gone"/>

            <TextView
                android:layout_width="20dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center|end"
                android:text="h"
                android:textColor="@color/number_picker_text_color"
                android:textSize="@dimen/text_size_20sp"
                android:visibility="gone"/>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/minuteLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/common_16dp"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@id/hourLayout"
            app:layout_constraintEnd_toStartOf="@id/secondLayout"
            app:layout_constraintTop_toBottomOf="@id/btnClose">

            <com.shawnlin.numberpicker.NumberPicker
                android:id="@+id/minutePicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:np_dividerColor="@color/mint"
                app:np_selectedTextColor="@color/number_picker_text_color"
                app:np_textColor="@color/grey_150"
                app:np_dividerThickness="@dimen/common_1dp"
                app:np_textSize="@dimen/text_size_14sp"
                app:np_wheelItemCount="5"
                app:np_itemSpacing="@dimen/common_10dp"
                app:np_selectedTextSize="@dimen/text_size_20sp"
                app:np_max="59"
                app:np_min="0"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center|end"
                android:text="m"
                android:textColor="@color/number_picker_text_color"
                android:textSize="@dimen/text_size_20sp"/>

        </FrameLayout>

        <FrameLayout
            android:id="@+id/secondLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/common_16dp"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/minuteLayout"
            app:layout_constraintTop_toBottomOf="@id/btnClose">

            <com.shawnlin.numberpicker.NumberPicker
                android:id="@+id/secondPicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:np_dividerColor="@color/mint"
                app:np_selectedTextColor="@color/number_picker_text_color"
                app:np_textColor="@color/grey_150"
                app:np_dividerThickness="@dimen/common_1dp"
                app:np_textSize="@dimen/text_size_14sp"
                app:np_wheelItemCount="5"
                app:np_itemSpacing="@dimen/common_10dp"
                app:np_selectedTextSize="@dimen/text_size_20sp"
                app:np_max="59"
                app:np_min="0"
                android:layout_marginStart="@dimen/common_20dp" />

            <TextView
                android:layout_width="20dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center|end"
                android:text="s"
                android:textColor="@color/number_picker_text_color"
                android:textSize="@dimen/text_size_20sp"
                android:fontFamily="@font/poppinsregular"/>
        </FrameLayout>

        <TextView
            android:id="@+id/btnNo"
            style="@style/ButtonCancelStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/common_16dp"
            android:text="@string/cancel"
            app:layout_constraintTop_toBottomOf="@id/minuteLayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnConfirm"
            android:layout_marginRight="@dimen/common_12dp"/>

        <TextView
            android:id="@+id/btnConfirm"
            style="@style/ButtonConfirmStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/common_16dp"
            android:text="@string/mgs_ok"
            app:layout_constraintTop_toBottomOf="@+id/minuteLayout"
            app:layout_constraintStart_toEndOf="@id/btnNo"
            app:layout_constraintEnd_toEndOf="parent"
            android:gravity="center" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>