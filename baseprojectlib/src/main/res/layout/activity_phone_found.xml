<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_EBFFEE">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bg_splash"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black_50"/>

    <TextView
        android:id="@+id/description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/plusjakartasansextrabold"
        android:gravity="center"
        android:text="@string/congratulations_nyou_have_found_your_phone"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_18sp"
        android:textAllCaps="true"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/rlBell"
        android:paddingHorizontal="@dimen/common_20dp"/>
    
    <RelativeLayout
        android:id="@+id/rlBell"
        android:layout_width="@dimen/common_240dp"
        android:layout_height="@dimen/common_240dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ivShadowBottom"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_round_shadow_bottom"/>

        <ImageView
            android:id="@+id/ivShadowTop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_round_shadow_top"
            android:layout_margin="@dimen/common_16dp"/>

        <ImageView
            android:id="@+id/ivStroke"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_stroke_button"
            android:layout_margin="@dimen/common_26dp"/>

        <ImageView
            android:id="@+id/ivWhite"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_round_white"
            android:layout_margin="@dimen/common_50dp"/>

        <ImageView
            android:id="@+id/ivBell"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/iv_bell"
            android:layout_margin="@dimen/common_50dp"
            android:padding="@dimen/common_30dp"/>

    </RelativeLayout>

    <TextView
        android:id="@+id/btnCloseService"
        android:layout_width="0dp"
        android:layout_height="@dimen/common_56dp"
        android:layout_marginBottom="@dimen/common_12dp"
        android:layout_marginTop="@dimen/common_50dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_button"
        android:text="@string/close_and_continue_listening"
        android:textAllCaps="true"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_16sp"
        android:fontFamily="@font/poppinsmedium"
        android:gravity="center"
        android:padding="@dimen/common_4dp"
        app:layout_constraintTop_toBottomOf="@+id/rlBell"
        app:layout_constraintBottom_toTopOf="@+id/btnCloseService2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.66"/>

    <TextView
        android:id="@+id/btnCloseService2"
        android:layout_width="0dp"
        android:layout_height="@dimen/common_56dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_button"
        android:text="@string/close_and_stop_service"
        android:textAllCaps="true"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_16sp"
        android:fontFamily="@font/poppinsmedium"
        android:gravity="center"
        android:padding="@dimen/common_4dp"
        app:layout_constraintTop_toBottomOf="@+id/btnCloseService"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.66"
        android:layout_marginTop="@dimen/common_12dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
</layout>